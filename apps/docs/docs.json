{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Franceschini Email",
  "colors": {
    "primary": "#21453D",
    "light": "#E6FAF5",
    "dark": "#21453D"
  },
  "background": {
    "color": {
      "light": "#F5F5F5",
      "dark": "#181825"
    }
  },
  "fonts": {
    "family": "IBM Plex Mono"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "get-started/nodejs",
              "get-started/python",
              "get-started/go",
              "get-started/local",
              "get-started/smtp"
            ]
          },
          {
            "group": "Guides",
            "pages": [
              "guides/webhooks",
              "guides/use-with-react-email"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Reference",
            "pages": ["api-reference/introduction"]
          },
          {
            "group": "Emails",
            "pages": [
              "api-reference/emails/get-email",
              "api-reference/emails/list-emails",
              "api-reference/emails/send-email",
              "api-reference/emails/batch-email",
              "api-reference/emails/update-schedule",
              "api-reference/emails/cancel-schedule"
            ]
          },
          {
            "group": "Domains",
            "pages": [
              "api-reference/domains/get-domain",
              "api-reference/domains/list-domains",
              "api-reference/domains/create-domain",
              "api-reference/domains/verify-domain",
              "api-reference/domains/delete-domain"
            ]
          },
          {
            "group": "Analytics",
            "pages": [
              "api-reference/analytics/email-time-series",
              "api-reference/analytics/reputation-metrics"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "groups": [
          {
            "group": "Updates",
            "pages": ["changelog"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/colinfran/franceschini-email",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/logo-wordmark.svg",
    "dark": "/logo/logo-wordmark-dark.svg"
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "mdx": {
      "server": "https://franceschini.email/api",
      "auth": {
        "method": "bearer"
      }
    }
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://franceschini.email"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/colinfran/franceschini-email"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity"]
  }
}
